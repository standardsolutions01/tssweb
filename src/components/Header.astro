---
/**
 * SITE HEADER (DESIGN.md §4)
 *  - Sticky, white, 72px; shrinks to 60px after scrolling (class added by src/scripts/site.ts).
 *  - Left: logo · Centre: menu (max 5) · Right: search + "Book a Free Consultation".
 *  - Desktop "Services" panel opens on hover or keyboard focus (no JavaScript needed).
 *  - Mobile: full-screen white menu using <details>, search bar at top, CTA at bottom.
 */
import { NAV, LINKS, SITE } from '../config/site';
import { SERVICES } from '../data/services';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';

const current = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && href !== '/' && current.startsWith(href);
const setUp = SERVICES.filter((s) => s.serviceType.startsWith('Company'));
const runGrow = SERVICES.filter((s) => !setUp.includes(s));
const groups = [
  { title: 'Set up your company', items: setUp },
  { title: 'Run & grow your finances', items: runGrow },
];
const servicesActive = SERVICES.some((s) => current.startsWith(`/${s.slug}/`));
---
<header class="site-header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.name} — home`}>
      <img src="/images/logo-header.webp" alt={SITE.name} width="298" height="215" />
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul class="menu-root">
        <li class="has-panel">
          <a href="/#services" class:list={['top-link', { active: servicesActive }]} aria-haspopup="true">
            Services <Icon name="chevron" class="chev" />
          </a>
          <div class="panel">
            {groups.map((g) => (
              <div class="panel-col">
                <p class="panel-title">{g.title}</p>
                <ul>
                  {g.items.map((s) => (
                    <li>
                      <a href={`/${s.slug}/`}>
                        <Icon name={s.icon} class="panel-icon" />
                        <span><strong>{s.name}</strong><span class="panel-line">{s.menuLine}</span></span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </li>
        {NAV.map((item) => (
          <li><a href={item.href} class:list={['top-link', { active: isActive(item.href) }]}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <button type="button" class="icon-btn" data-search-open aria-label="Search the site (press /)">
        <Icon name="search" />
      </button>
      <ExternalLink href={LINKS.booking} class="btn btn--primary btn--sm cta">Book a Free Consultation</ExternalLink>

      <details class="mobile-nav" data-mobile-nav>
        <summary aria-label="Open menu"><span class="burger" aria-hidden="true"></span></summary>
        <div class="mobile-panel">
          <button type="button" class="mobile-search" data-search-open>
            <Icon name="search" /> <span>Search services and guides</span>
          </button>
          <nav aria-label="Mobile">
            {groups.map((g) => (
              <div class="m-group">
                <p class="panel-title">{g.title}</p>
                <ul>{g.items.map((s) => <li><a href={`/${s.slug}/`}>{s.name}</a></li>)}</ul>
              </div>
            ))}
            <ul class="m-main">{NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
          </nav>
          <ExternalLink href={LINKS.booking} class="btn btn--primary m-cta">Book a Free Consultation</ExternalLink>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; background: var(--white);
    border-bottom: 1px solid var(--line); transition: box-shadow .2s;
  }
  .bar { display: flex; align-items: center; gap: 20px; height: var(--header-h); transition: height .2s var(--ease); }
  .site-header.is-scrolled .bar { height: var(--header-h-small); }
  .site-header.is-scrolled { box-shadow: 0 1px 2px rgba(0, 0, 0, .04); }

  .brand { display: flex; align-items: center; flex: none; padding: 4px 0; }
  .brand img { height: 58px; width: auto; transition: height .2s var(--ease); }
  .site-header.is-scrolled .brand img { height: 48px; }

  /* ---- Desktop menu ---- */
  .desktop-nav { display: none; flex: 1; justify-content: center; }
  .menu-root { list-style: none; display: flex; align-items: center; gap: 4px; margin: 0; padding: 0; }
  .top-link {
    display: inline-flex; align-items: center; gap: 4px; padding: 10px 14px; border-radius: 999px;
    color: var(--ink); text-decoration: none; font-size: 1rem; font-weight: 500; transition: color .2s, background-color .2s;
  }
  .top-link:hover, .top-link.active { color: var(--tss-blue); }
  .top-link :global(.chev) { width: 16px; height: 16px; transition: transform .2s; }

  .has-panel { position: relative; }
  .has-panel::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 18px; }
  .panel {
    position: absolute; top: calc(100% + 14px); left: -24px; width: 680px; transform: translateY(6px);
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; padding: 24px;
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 12px 32px rgba(13, 27, 46, .08);
    opacity: 0; visibility: hidden; transition: opacity .2s, transform .2s, visibility .2s;
  }
  .has-panel:hover .panel, .has-panel:focus-within .panel { opacity: 1; visibility: visible; transform: none; }
  .has-panel:hover :global(.chev), .has-panel:focus-within :global(.chev) { transform: rotate(180deg); }
  .panel-title { font-size: .72rem; font-weight: 500; letter-spacing: .25em; text-transform: uppercase; color: var(--tss-grey); margin: 0 0 8px 12px; }
  .panel ul { list-style: none; margin: 0; padding: 0; }
  .panel a {
    display: flex; gap: 14px; align-items: flex-start; padding: 12px; border-radius: 12px;
    text-decoration: none; color: var(--ink); transition: background-color .2s;
  }
  .panel a:hover { background: var(--light-grey); }
  .panel a:hover strong { color: var(--tss-blue); }
  .panel :global(.panel-icon) { width: 22px; height: 22px; color: var(--tss-blue); flex: none; margin-top: 2px; }
  .panel strong { display: block; font-weight: 500; font-size: 1rem; line-height: 1.35; transition: color .2s; }
  .panel-line { display: block; font-size: .9rem; color: var(--ink-soft); line-height: 1.45; margin-top: 2px; }

  /* ---- Right-hand actions ---- */
  .actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .icon-btn {
    width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%;
    border: 0; background: transparent; color: var(--ink); cursor: pointer; transition: background-color .2s, color .2s;
  }
  .icon-btn:hover { background: var(--light-grey); color: var(--tss-blue); }
  .icon-btn :global(svg) { width: 22px; height: 22px; }
  .actions :global(.cta) { display: none; }

  /* ---- Mobile menu (full screen) ---- */
  .mobile-nav summary {
    list-style: none; cursor: pointer; width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%;
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .burger, .burger::before, .burger::after { display: block; width: 22px; height: 1.5px; background: var(--ink); position: relative; transition: transform .2s, background-color .2s; }
  .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
  .burger::before { top: -7px; } .burger::after { top: 7px; }
  .mobile-nav[open] .burger { background: transparent; }
  .mobile-nav[open] .burger::before { transform: translateY(7px) rotate(45deg); }
  .mobile-nav[open] .burger::after { transform: translateY(-7px) rotate(-45deg); }
  .mobile-panel {
    position: fixed; left: 0; right: 0; bottom: 0; top: var(--header-h); z-index: 49;
    background: var(--white); overflow-y: auto; display: flex; flex-direction: column; gap: 24px;
    padding: 20px var(--gutter) calc(24px + env(safe-area-inset-bottom, 0px));
  }
  .site-header.is-scrolled .mobile-panel { top: var(--header-h-small); }
  .mobile-search {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 52px; padding: 0 18px;
    border: 1px solid var(--line); border-radius: 999px; background: var(--light-grey);
    font: inherit; font-size: 1rem; color: var(--ink-soft); cursor: pointer; text-align: left;
  }
  .mobile-search :global(svg) { width: 20px; height: 20px; color: var(--tss-blue); }
  .mobile-panel ul { list-style: none; margin: 0; padding: 0; }
  .mobile-panel .panel-title { margin: 0 0 4px; }
  .m-group { border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 12px; }
  .mobile-panel a:not(.btn) {
    display: flex; align-items: center; min-height: 48px; color: var(--ink); text-decoration: none; font-size: 1.1rem; font-weight: 500;
  }
  .mobile-panel a:not(.btn):hover { color: var(--tss-blue); }
  .mobile-panel :global(.m-cta) { margin-top: auto; width: 100%; min-height: 52px; position: sticky; bottom: 0; box-shadow: 0 -12px 16px var(--white); }

  @media (max-width: 480px) { .brand img { height: 50px; } .site-header.is-scrolled .brand img { height: 44px; } }
  @media (min-width: 1100px) {
    .desktop-nav { display: flex; }
    .mobile-nav { display: none; }
    .actions :global(.cta) { display: inline-flex; }
  }
</style>
