---
/**
 * Site header. Works WITHOUT JavaScript:
 *  - Desktop: "Services" menu opens on hover / keyboard focus.
 *  - Mobile: the menu button uses the built-in <details> element.
 */
import { NAV, LINKS, SITE } from '../config/site';
import { SERVICES } from '../data/services';
import ExternalLink from './ExternalLink.astro';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.name} — home`}>
      <img src="/images/logo-tss.webp" alt="" width="44" height="45" />
      <span class="brand-text"><span class="the">The</span> Standard <span class="sol">Solutions</span></span>
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul>
        <li class="has-menu">
          <a href="/#services" class:list={[{ active: SERVICES.some((s) => isActive(`/${s.slug}/`)) }]}>Services</a>
          <ul class="menu">
            {SERVICES.map((s) => <li><a href={`/${s.slug}/`}>{s.name}</a></li>)}
          </ul>
        </li>
        {NAV.map((item) => (
          <li><a href={item.href} class:list={[{ active: isActive(item.href) }]}>{item.label}</a></li>
        ))}
      </ul>
      <ExternalLink href={LINKS.booking} class="btn btn--primary btn--sm">Book a Free Consultation</ExternalLink>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Menu"><span class="burger" aria-hidden="true"></span><span class="label">Menu</span></summary>
      <nav class="mobile-panel" aria-label="Mobile">
        <p class="group">Services</p>
        <ul>{SERVICES.map((s) => <li><a href={`/${s.slug}/`}>{s.name}</a></li>)}</ul>
        <hr />
        <ul>{NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        <ExternalLink href={LINKS.booking} class="btn btn--primary">Book a Free Consultation</ExternalLink>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.96); border-bottom: 1px solid var(--line); backdrop-filter: saturate(160%) blur(8px); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--brand-grey); }
  .brand img { width: 44px; height: auto; }
  .brand-text { font-weight: 600; letter-spacing: .14em; text-transform: uppercase; font-size: .9rem; white-space: nowrap; }
  .brand-text .the { color: var(--brand-blue); }
  .brand-text .sol { color: var(--brand-blue); }

  .desktop-nav { display: none; align-items: center; gap: 28px; }
  .desktop-nav > ul { list-style: none; display: flex; gap: 26px; margin: 0; padding: 0; }
  .desktop-nav a { color: var(--ink); text-decoration: none; font-weight: 500; font-size: .98rem; }
  .desktop-nav a:hover, .desktop-nav a.active { color: var(--brand-blue); }
  .desktop-nav a.btn { color: #fff; }
  .btn--sm { padding: 10px 18px; font-size: .92rem; }

  .has-menu { position: relative; }
  .has-menu > a::after { content: ''; display: inline-block; margin-left: 6px; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-3px) rotate(45deg); }
  .menu {
    list-style: none; margin: 0; padding: 10px; position: absolute; top: 100%; left: -16px; min-width: 280px;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 12px 30px rgba(13,27,46,.08);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .15s, transform .15s, visibility .15s;
  }
  .has-menu::before { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 14px; }
  .menu { margin-top: 12px; }
  .has-menu:hover .menu, .has-menu:focus-within .menu { opacity: 1; visibility: visible; transform: none; }
  .menu a { display: block; padding: 9px 12px; border-radius: 6px; }
  .menu a:hover { background: var(--surface-alt); }

  .mobile-nav summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 8px; padding: 8px 4px; font-weight: 600; color: var(--ink); }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .burger, .burger::before, .burger::after { display: block; width: 22px; height: 2px; background: var(--ink); position: relative; transition: transform .2s; }
  .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
  .burger::before { top: -7px; } .burger::after { top: 7px; }
  .mobile-nav[open] .burger { background: transparent; }
  .mobile-nav[open] .burger::before { transform: translateY(7px) rotate(45deg); }
  .mobile-nav[open] .burger::after { transform: translateY(-7px) rotate(-45deg); }
  .mobile-panel {
    position: absolute; left: 0; right: 0; top: 72px; background: #fff; border-bottom: 1px solid var(--line);
    padding: 16px 20px 24px; max-height: calc(100vh - 72px); overflow-y: auto; box-shadow: 0 16px 30px rgba(13,27,46,.08);
  }
  .mobile-panel ul { list-style: none; margin: 0; padding: 0; }
  .mobile-panel a:not(.btn) { display: block; padding: 10px 0; color: var(--ink); text-decoration: none; font-weight: 500; }
  .mobile-panel .group { font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--brand-grey); margin: 4px 0 2px; font-weight: 600; }
  .mobile-panel hr { border: 0; border-top: 1px solid var(--line); margin: 10px 0; }
  .mobile-panel .btn { margin-top: 14px; width: 100%; }

  @media (max-width: 480px) {
    .brand img { width: 38px; }
    .brand-text { font-size: .76rem; letter-spacing: .1em; }
    .mobile-nav .label { display: none; }
  }
  @media (min-width: 1000px) {
    .desktop-nav { display: flex; }
    .mobile-nav { display: none; }
  }
</style>
