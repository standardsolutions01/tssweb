---
/** Closing call-to-action: centred, light-grey band (DESIGN.md §6.10). */
import CtaButtons from './CtaButtons.astro';
interface Props { title?: string; text?: string; }
const {
  title = "Not sure where to start? Let's talk.",
  text = 'A free, no-obligation consultation. We will listen, ask the right questions and tell you honestly how we can help.',
} = Astro.props;
---
<section class="cta-band section" data-pagefind-ignore>
  <div class="container center">
    <h2>{title}</h2>
    <p class="lead">{text}</p>
    <CtaButtons />
  </div>
</section>
<style>
  .cta-band { background: var(--light-grey); position: relative; overflow: hidden; }
  .cta-band::before {
    content: ''; position: absolute; width: 360px; height: 360px; left: -180px; top: -200px; border-radius: 50%;
    border: 1px solid transparent; border-bottom-color: var(--tss-red); border-right-color: var(--tss-red);
    transform: rotate(10deg); pointer-events: none;
  }
  .cta-band .container { position: relative; }
  .cta-band h2 { margin-bottom: 16px; }
</style>
