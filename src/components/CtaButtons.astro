---
/**
 * The two main buttons (never more than two side by side):
 * "Book a Free Consultation" (solid blue) + "Chat on WhatsApp" (outline).
 * Both open in a new tab.
 */
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import { LINKS, whatsappUrl } from '../config/site';
---
<div class="btn-row">
  <ExternalLink href={LINKS.booking} class="btn btn--primary"><Icon name="calendar" />Book a Free Consultation</ExternalLink>
  <ExternalLink href={whatsappUrl} class="btn btn--outline"><Icon name="whatsapp" />Chat on WhatsApp</ExternalLink>
</div>
