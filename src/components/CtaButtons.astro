---
/**
 * The two main call-to-action buttons used across the site:
 * "Book a Strategy Call" (Google Calendar) and "Let's Chat" (WhatsApp).
 * Rule: no "free" on buttons — say "free 30-minute strategy call" in descriptions instead.
 * Both open in a new tab.
 */
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import { LINKS, whatsappUrl } from '../config/site';
interface Props { variant?: 'default' | 'dark'; }
const { variant = 'default' } = Astro.props;
const primary = variant === 'dark' ? 'btn btn--light' : 'btn btn--primary';
const secondary = variant === 'dark' ? 'btn btn--ghost-light' : 'btn btn--outline';
---
<div class="btn-row">
  <ExternalLink href={LINKS.booking} class={primary}><Icon name="calendar" />Book a Strategy Call</ExternalLink>
  <ExternalLink href={whatsappUrl} class={secondary}><Icon name="whatsapp" />Let's Chat</ExternalLink>
</div>
