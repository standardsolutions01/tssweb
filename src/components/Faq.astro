---
/**
 * FAQ accordion (DESIGN.md §10). Uses <details name="…"> so only one answer
 * is open at a time — built into the browser, no JavaScript.
 * The matching FAQPage data for Google is added by the page (src/lib/schema.ts).
 */
export interface FaqItem { q: string; a: string; link?: { href: string; label: string }; }
interface Props { items: FaqItem[]; title?: string; group?: string; showTitle?: boolean; }
const { items, title = 'Frequently asked questions', group = 'faq', showTitle = true } = Astro.props;
---
<div class="faq">
  {showTitle && <h2>{title}</h2>}
  {items.map((item) => (
    <details name={group}>
      <summary>{item.q}<span class="pm" aria-hidden="true"></span></summary>
      <div class="answer">
        <p>{item.a}</p>
        {item.link && <p class="more-link"><a href={item.link.href}>{item.link.label} →</a></p>}
      </div>
    </details>
  ))}
</div>
<style>
  .faq h2 { margin-bottom: 28px; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq details:first-of-type { border-top: 1px solid var(--line); }
  .faq summary {
    cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding: 22px 0; font-weight: 500; font-size: 1.1rem; transition: color .2s;
  }
  .faq summary:hover { color: var(--tss-blue); }
  .faq summary::-webkit-details-marker { display: none; }
  .pm { position: relative; width: 16px; height: 16px; flex: none; }
  .pm::before, .pm::after { content: ''; position: absolute; left: 0; top: 7.5px; width: 16px; height: 1.5px; background: var(--tss-blue); transition: transform .2s; }
  .pm::after { transform: rotate(90deg); }
  .faq details[open] .pm::after { transform: rotate(0deg); }
  .faq .answer { padding: 0 36px 24px 0; color: var(--ink-soft); }
  .faq .answer p { margin: 0 0 8px; }
  .faq .more-link a { font-weight: 500; text-decoration: none; }
  .faq .more-link a:hover { text-decoration: underline; }
</style>
