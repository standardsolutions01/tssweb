---
/**
 * Floating WhatsApp button (DESIGN.md §10): small, round, bottom-right.
 * Appears after the visitor has scrolled 30% of the page (src/scripts/site.ts).
 */
import { whatsappUrl } from '../config/site';
import Icon from './Icon.astro';
---
<a href={whatsappUrl} class="wa-float" data-wa-float target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp (opens in a new tab)">
  <Icon name="whatsapp" />
</a>
<style>
  .wa-float {
    position: fixed; z-index: 40;
    right: max(16px, env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center;
    background: var(--white); color: #1fa855; border: 1px solid var(--line);
    box-shadow: 0 6px 18px rgba(13, 27, 46, .10);
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity .3s, transform .3s, visibility .3s, color .2s;
  }
  .wa-float.is-visible { opacity: 1; visibility: visible; transform: none; }
  .wa-float:hover { color: #178a45; }
  .wa-float :global(svg) { width: 26px; height: 26px; }
  @media print { .wa-float { display: none; } }
</style>
