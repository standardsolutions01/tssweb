---
import { SITE, CONTACT, LINKS, DISCLAIMER, NAV, whatsappUrl } from '../config/site';
import { SERVICES } from '../data/services';
import ExternalLink from './ExternalLink.astro';
const year = new Date().getFullYear();
const socials = [
  { label: 'LinkedIn', href: LINKS.linkedinCompany },
  { label: 'Facebook', href: LINKS.facebook },
  { label: 'Instagram', href: LINKS.instagram },
].filter((s) => s.href);
---
<footer class="site-footer">
  <div class="container cols">
    <div class="about">
      <p class="name">{SITE.name}</p>
      <p class="tag">{SITE.tagline}</p>
      <p>Company formation, bookkeeping and finance support — one partner from registration to reporting.</p>
    </div>
    <div>
      <p class="head">Services</p>
      <ul>{SERVICES.map((s) => <li><a href={`/${s.slug}/`}>{s.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="head">Company</p>
      <ul>
        {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Service</a></li>
      </ul>
    </div>
    <div>
      <p class="head">Contact</p>
      <ul>
        <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        <li><ExternalLink href={whatsappUrl}>WhatsApp {CONTACT.phoneDisplay}</ExternalLink></li>
        <li>{CONTACT.locationPublic}</li>
        <li><ExternalLink href={LINKS.booking}>Book a free consultation</ExternalLink></li>
        {socials.map((s) => <li><ExternalLink href={s.href}>{s.label}</ExternalLink></li>)}
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p class="disclaimer">{DISCLAIMER}</p>
    <p>© {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>
<style>
  .site-footer { background: var(--footer-bg); color: var(--footer-ink); padding: 64px 0 90px; font-size: .95rem; }
  .cols { display: grid; gap: 36px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .site-footer a { color: var(--footer-ink); text-decoration: none; }
  .site-footer a:hover { color: #fff; text-decoration: underline; }
  .name { color: #fff; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 6px; }
  .tag { color: #8fb4ff; font-style: italic; }
  .head { color: #fff; font-weight: 600; margin-bottom: 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .legal { border-top: 1px solid rgba(255,255,255,.12); margin-top: 44px; padding-top: 24px; font-size: .85rem; color: #93a0b2; }
  .legal p { margin: 0 0 8px; }
  .disclaimer { max-width: 820px; }
</style>
