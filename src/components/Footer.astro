---
/**
 * SITE FOOTER (DESIGN.md §9)
 * Deep navy, thin red line on top (the only accent), white text wordmark
 * (never the logo image on navy), 4 columns, then © · policies · disclaimer.
 */
import { SITE, CONTACT, LINKS, DISCLAIMER, NAV, whatsappUrl } from '../config/site';
import { SERVICES } from '../data/services';
import ExternalLink from './ExternalLink.astro';
const year = new Date().getFullYear();
const policies = [
  { href: '/terms/', label: 'Terms' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/refund-policy/', label: 'Refunds' },
  { href: '/complaints/', label: 'Complaints' },
];
const socials = [
  { label: 'LinkedIn', href: LINKS.linkedinCompany },
  { label: 'Facebook', href: LINKS.facebook },
  { label: 'Instagram', href: LINKS.instagram },
].filter((s) => s.href);
---
<footer class="site-footer">
  <div class="container cols">
    <div class="brand-col">
      <p class="wordmark"><span class="the">The</span> Standard Solutions</p>
      <p class="tag">{SITE.tagline}</p>
    </div>
    <div>
      <p class="head">Services</p>
      <ul>{SERVICES.map((s) => <li><a href={`/${s.slug}/`}>{s.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="head">Company</p>
      <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <p class="head">Contact</p>
      <ul>
        <li><ExternalLink href={whatsappUrl}>WhatsApp {CONTACT.phoneDisplay}</ExternalLink></li>
        <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        <li>{CONTACT.locationPublic}</li>
        {socials.map((s) => <li><ExternalLink href={s.href}>{s.label}</ExternalLink></li>)}
      </ul>
    </div>
  </div>
  <div class="container">
    <div class="bottom">
      <p class="copy">© {year} {SITE.name}</p>
      <nav aria-label="Policies"><ul class="policies">{policies.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul></nav>
      <p class="disclaimer">{DISCLAIMER}</p>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    background: var(--deep-navy); color: rgba(255, 255, 255, .7); border-top: 1px solid var(--tss-red);
    padding: 72px 0 calc(40px + env(safe-area-inset-bottom, 0px)); font-size: 1rem;
  }
  .cols { display: grid; gap: 40px 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  @media (min-width: 1024px) { .cols { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; } }
  .cols > div { min-width: 0; }
  .site-footer a { color: rgba(255, 255, 255, .7); text-decoration: none; overflow-wrap: anywhere; transition: color .2s; }
  .site-footer a:hover { color: #fff; }
  .wordmark { color: #fff; font-size: 1.15rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 10px; line-height: 1.4; }
  .wordmark .the { text-transform: none; letter-spacing: 0; font-style: italic; font-weight: 400; margin-right: 2px; }
  .tag { max-width: 260px; }
  .head { color: #fff; font-weight: 500; margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .bottom {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px;
    border-top: 1px solid rgba(255, 255, 255, .12); margin-top: 56px; padding-top: 24px; font-size: .9rem;
  }
  .bottom p { margin: 0; }
  .policies { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .disclaimer { flex-basis: 100%; color: rgba(255, 255, 255, .55); max-width: 820px; }
</style>
