---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you are looking for could not be found." noindex>
  <section class="section">
    <div class="container narrow center">
      <p class="eyebrow">Error 404</p>
      <h1>Sorry, we can't find that page</h1>
      <p class="lead">It may have moved or no longer exists.</p>
      <div class="btn-row"><a href="/" class="btn btn--primary">Go to home page</a><a href="/contact/" class="btn btn--outline">Contact us</a></div>
    </div>
  </section>
</BaseLayout>
